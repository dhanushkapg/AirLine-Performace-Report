table flights
	lineageTag: 7821d3fa-b97f-4ad3-b69d-957a29753855

	measure 'Total Flights' = COUNTROWS(flights)
		formatString: #,0
		lineageTag: 6e9f9edc-5b99-43b8-b681-f31db4faea67

	measure 'Completed Flights' = COUNT(flights[ARRIVAL_DELAY])
		formatString: #,0
		lineageTag: 3f136d60-e65f-43f0-8e26-c1ce75432631

	measure 'Delayed Flights' = CALCULATE(COUNTROWS(flights), flights[ARRIVAL_DELAY] >= 15)
		formatString: #,0
		lineageTag: b240a294-1dc5-49b2-bb6f-d38a3f6e44c1

	measure 'Delay Rate' = DIVIDE([Delayed Flights], [Completed Flights])
		formatString: 0.0%
		lineageTag: 21247d76-5288-4a9a-bbd1-3301710a9b73

	measure 'Avg Delay When Late' = CALCULATE(AVERAGE(flights[ARRIVAL_DELAY]), flights[ARRIVAL_DELAY] >= 15)
		formatString: 0.0
		lineageTag: 8508ab63-8b0b-4447-adf8-fbccc032d6e8

	measure 'Severe Delays 60+ Min' = CALCULATE(COUNTROWS(flights), flights[ARRIVAL_DELAY] >= 60)
		formatString: #,0
		lineageTag: e6fa2f22-1135-44fe-a7d2-ba10b451fa27

	measure 'Cancelled Flights' = SUM(flights[CANCELLED])
		formatString: #,0
		lineageTag: e4cbacc4-892e-4811-a1ba-2a8f1f7ba9a4

	measure 'Cancellation Rate' = DIVIDE([Cancelled Flights], [Total Flights])
		formatString: 0.0%
		lineageTag: 29392cbe-030b-49c0-8390-bfec7b70eaf3

	measure 'Delay Minutes by Cause' = SWITCH(SELECTEDVALUE('Delay Cause'[Cause]), "Late aircraft", SUM(flights[LATE_AIRCRAFT_DELAY]), "Airline", SUM(flights[AIRLINE_DELAY]), "Air system", SUM(flights[AIR_SYSTEM_DELAY]), "Weather", SUM(flights[WEATHER_DELAY]), "Security", SUM(flights[SECURITY_DELAY]))
		formatString: #,0
		lineageTag: 67cdb472-acf6-4654-be7a-12eda4bdfe2f

	measure 'Destination Delayed Flights' = CALCULATE([Delayed Flights], USERELATIONSHIP(flights[DESTINATION_AIRPORT], airports[IATA_CODE]))
		formatString: #,0
		lineageTag: e36104ce-76d4-4603-92f5-d7ac2794c387

	measure 'Top 15 Origin Delayed' = IF(NOT ISBLANK(SELECTEDVALUE(airports[AIRPORT])) && RANKX(FILTER(ALLSELECTED(airports), NOT ISBLANK(airports[AIRPORT])), [Delayed Flights]) <= 15, [Delayed Flights])
		formatString: #,0
		lineageTag: c9f517b0-56c4-42bd-a3ef-3a7ad9c1d9cf

	measure 'Top 15 Destination Delayed' = IF(NOT ISBLANK(SELECTEDVALUE(airports[AIRPORT])) && RANKX(FILTER(ALLSELECTED(airports), NOT ISBLANK(airports[AIRPORT])), [Destination Delayed Flights]) <= 15, [Destination Delayed Flights])
		formatString: #,0
		lineageTag: 96609022-9467-4b86-abf5-8b1f9fd3d613

	measure 'Top 15 Origin Delay Rate' = IF(NOT ISBLANK([Top 15 Origin Delayed]), [Delay Rate])
		formatString: 0.0%
		lineageTag: 25673566-8608-4b4d-824e-7fcf0ef51fe8

	measure 'Top 15 Origin Flights' = IF(NOT ISBLANK([Top 15 Origin Delayed]), [Completed Flights])
		formatString: #,0
		lineageTag: 4bca7ce3-86a1-43c9-829d-324ea42971a3

	measure 'Completed Flights_new' = CALCULATE(COUNTROWS(flights),flights[DIVERTED]=0,flights[CANCELLED]=0)
		formatString: 0
		lineageTag: 82829133-750f-4a36-8077-3baef1b4b462

